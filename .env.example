# ==============================================================================
# AI Work Copilot - Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python AI / RAG Service (ai-service/)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=ai_work_copilot
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5

# ------------------------------------------------------------------------------
# 2. Spring Boot Java Backend (backend/)
# ------------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
PORT=8080

# Optional: Default uses embedded H2 database.
# To use MySQL, uncomment the lines below:
# SPRING_PROFILES_ACTIVE=mysql
# DATABASE_URL=jdbc:mysql://localhost:3306/ai_work_copilot
# DATABASE_USERNAME=root
# DATABASE_PASSWORD=
